# Copy to .env.local (local) and add the same keys in Vercel → Settings → Environment Variables.

# Postgres (local: run `npm run db:local`; production: Neon/Supabase pooled URL with ?sslmode=require)
DATABASE_URL="postgres://postgres:postgres@localhost:5433/malaria"
# Any long random string; Vercel Cron sends it to /api/cron/sync-mis
CRON_SECRET=""

# Optional — full AI analyst (Claude Opus 5). Without it the built-in offline assistant answers common questions.
ANTHROPIC_API_KEY=""

# Optional — email alerts for deaths and case surges (Gmail App Password, see the Alerts tab)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
ALERT_EMAIL_TO="shahriarnmp@gmail.com"
# Link included in alert emails
APP_URL="http://localhost:3000"
